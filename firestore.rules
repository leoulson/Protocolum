rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
// Shared community: authenticated readers, posts and replies attributed to their author.
match /forum_posts/{postId} {
  function signedIn() { return request.auth != null; }
  function validPost() {
    let p = request.resource.data;
    return p.userId == request.auth.uid && p.author is string && p.author.size() > 0 && p.author.size() <= 80
      && p.timestamp == request.time
      && ((p.kind == 'case'
        && p.keys().hasOnly(['userId','author','kind','timestamp','assessment','plan','reference'])
        && p.assessment is string && p.assessment.size() >= 10 && p.assessment.size() <= 2400
        && p.plan is string && p.plan.size() >= 10 && p.plan.size() <= 2400
        && p.reference is string && p.reference.size() >= 3 && p.reference.size() <= 240)
      || (p.kind == 'general'
        && p.keys().hasOnly(['userId','author','kind','timestamp','title','body','topic'])
        && p.title is string && p.title.size() > 0 && p.title.size() <= 90
        && p.body is string && p.body.size() > 0 && p.body.size() <= 1200
        && p.topic is string && p.topic.size() > 0 && p.topic.size() <= 80));
  }
  allow get: if signedIn();
  allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
  allow create: if signedIn() && validPost();
  allow update: if false;
  allow delete: if signedIn() && resource.data.userId == request.auth.uid;
  match /replies/{replyId} {
    allow read: if signedIn();
    allow create: if signedIn()
      && exists(/databases/$(database)/documents/forum_posts/$(postId))
      && request.resource.data.keys().hasOnly(['userId','author','body','createdAt'])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 80
      && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if signedIn() && resource.data.userId == request.auth.uid;
  }
  match /votes/{uid} {
    allow read: if signedIn();
    allow create, update: if signedIn() && request.auth.uid == uid
      && exists(/databases/$(database)/documents/forum_posts/$(postId))
      && request.resource.data.keys().hasOnly(['supported','citation','like'])
      && request.resource.data.keys().hasAll(['supported','citation','like'])
      && request.resource.data.supported is bool && request.resource.data.citation is bool && request.resource.data.like is bool;
    allow delete: if signedIn() && request.auth.uid == uid;
  }
}
// Study data is private to the authenticated account, including each note.
match /private_study/{uid} {
  function owner() { return request.auth != null && request.auth.uid == uid; }
  allow get, delete: if owner();
  allow list: if false;
  allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['favorites'])
    && request.resource.data.keys().hasAll(['favorites'])
    && request.resource.data.favorites is list
    && request.resource.data.favorites.size() <= 2000;
  match /notes/{guidelineId} {
    allow get, list, delete: if owner();
    allow create, update: if owner()
      && request.resource.data.keys().hasOnly(['text'])
      && request.resource.data.keys().hasAll(['text'])
      && request.resource.data.text is string
      && request.resource.data.text.size() <= 3000;
  }
}
// Private cloud profile: only its authenticated owner can read or write it.
match /private_profiles/{uid} {
  function owner() { return request.auth != null && request.auth.uid == uid; }
  function validPrivateProfile() {
    let p = request.resource.data;
    return p.keys().hasOnly(['name','role','specialty','institution','city','bio','orcid','lattes','articles','theme','friends'])
      && p.keys().hasAll(['name','role','specialty','institution','city','bio','orcid','lattes','articles','theme','friends'])
      && p.name is string && p.name.size() > 0 && p.name.size() <= 80
      && p.role is string && p.role.size() <= 80
      && p.specialty is string && p.specialty.size() <= 80
      && p.institution is string && p.institution.size() <= 160
      && p.city is string && p.city.size() <= 100
      && p.bio is string && p.bio.size() <= 600
      && p.orcid is string && p.orcid.size() <= 19
      && p.lattes is string && p.lattes.size() <= 16
      && p.articles is list && p.articles.size() <= 100
      && p.friends is list && p.friends.size() <= 100
      && p.theme in ['ocean','violet','emerald'];
  }
  allow get, delete: if owner();
  allow create, update: if owner() && validPrivateProfile();
  allow list: if false;
}
match /network_profiles/{uid} {
  function signedIn() { return request.auth != null; }
  function owner() { return signedIn() && request.auth.uid == uid; }
  function validProfile() {
    let p = request.resource.data;
    return p.keys().hasOnly(['uid','name','nameSearch','role','specialty','institution','city','bio','orcid','lattes','articles','theme'])
      && p.keys().hasAll(['uid','name','nameSearch','role','specialty','institution','city','bio','orcid','lattes','articles','theme'])
      && p.uid == uid && p.name is string && p.name.size() > 0 && p.name.size() <= 80
      && p.nameSearch is string && p.nameSearch.size() <= 80
      && p.role is string && p.role.size() <= 80
      && p.specialty is string && p.specialty.size() <= 80
      && p.institution is string && p.institution.size() <= 160
      && p.city is string && p.city.size() <= 100
      && p.bio is string && p.bio.size() <= 600
      && p.orcid is string && p.orcid.size() <= 19
      && p.lattes is string && p.lattes.size() <= 16
      && p.articles is list && p.articles.size() <= 100
      && p.theme in ['ocean','violet','emerald'];
  }
  allow get: if signedIn();
  allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20;
  allow create, update: if owner() && validProfile();
  allow delete: if owner();
}
match /network_connections/{pairId} {
  function signedIn() { return request.auth != null; }
  function participant() { return signedIn() && request.auth.uid in resource.data.members; }
  allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
  allow list: if participant();
  allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['members','sender','recipient','status'])
    && request.resource.data.keys().hasAll(['members','sender','recipient','status'])
    && request.resource.data.sender == request.auth.uid
    && request.resource.data.recipient is string
    && request.resource.data.recipient != request.auth.uid
    && request.resource.data.members is list && request.resource.data.members.size() == 2
    && request.resource.data.members[0] is string && request.resource.data.members[1] is string
    && request.resource.data.members[0] < request.resource.data.members[1]
    && request.resource.data.sender in request.resource.data.members
    && request.resource.data.recipient in request.resource.data.members
    && pairId == request.resource.data.members[0] + '~' + request.resource.data.members[1]
    && request.resource.data.status == 'pending'
    && exists(/databases/$(database)/documents/network_profiles/$(request.resource.data.recipient));
  allow update: if participant()
    && resource.data.recipient == request.auth.uid && resource.data.status == 'pending'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status == 'accepted';
  allow delete: if participant();
}

}
}
